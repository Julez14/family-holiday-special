{
  "name": "family-holiday-special",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "types": "wrangler types --strict-vars false && wrangler types real-configuration.d.ts --config wrangler.real.jsonc --env-interface RealEnv --include-runtime false --strict-vars false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:media": "python3 -m unittest discover -s renderer -p 'test_*.py' -v",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check": "npm run typecheck && npm test && npm run build",
    "fixtures": "python3 scripts/build_fixtures.py",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:real": "npm run build && wrangler deploy --config wrangler.real.jsonc"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@mediapipe/tasks-vision": "^1.2.2",
    "hono": "^4.13.17",
    "image-size": "^2.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
